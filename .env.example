# Postgres connection string for account features (any provider: Neon,
# Vercel Postgres, Supabase, local Postgres). The Sleeper tools work without
# it; only signup/login/profile-sync routes need it.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth.js session-signing secret. Generate with: openssl rand -base64 32
# AUTH_SECRET=
